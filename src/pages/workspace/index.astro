---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="workspace — onmk" hideNav hideFooter bodyClass="workspace-page">
  <a class="home" href="/" aria-label="トップに戻る" data-astro-reload>
    <img src="/assets/onmk-icon.jpg" alt="" width="24" height="24" />
  </a>
  <main class="workspace">
    <div class="directory-browser">
    <svg class="directory-pipes" aria-hidden="true"><path /></svg>
    <ul class="roots" aria-label="ディレクトリ">
      <li><button class="folder" aria-expanded="false" aria-controls="x-timeline-pages"><span aria-hidden="true">- </span>X-timeline-fall/</button></li>
      <li><button class="folder" aria-expanded="false" aria-controls="wadalab-pages"><span aria-hidden="true">- </span>wadalab-motion/</button></li>
    </ul>
    <ul class="pages" id="x-timeline-pages" aria-label="X-timeline-fallのページ" aria-hidden="true" inert>
      <li><a href="/workspace/x-timeline-fall/" data-astro-reload>index.html</a></li>
    </ul>
    <ul class="pages" id="wadalab-pages" aria-label="wadalab-motionのページ" aria-hidden="true" inert>
        <li><a href="/workspace/wadalab-motion/" data-astro-reload>index.html</a></li>
        <li><a href="/workspace/wadalab-motion/wadamotion-1/" data-astro-reload>Wadamotion-1/</a></li>
        <li><a href="/workspace/wadalab-motion/wadamotion-2/" data-astro-reload>Wadamotion-2/</a></li>
        <li><a href="/workspace/wadalab-motion/wadamotion-3/" data-astro-reload>Wadamotion-3/</a></li>
        <li><a href="/workspace/wadalab-motion/clock-flow/" data-astro-reload>Clock/</a></li>
    </ul>
    </div>
  </main>
</Layout>

<script>
  function initializeDirectory() {
    const directory = document.querySelector<HTMLElement>('.workspace');
    if (!directory || directory.dataset.keyboardReady) return;
    directory.dataset.keyboardReady = 'true';
    const folders = Array.from(directory.querySelectorAll<HTMLButtonElement>('.folder'));
    const roots = directory.querySelector<HTMLElement>('.roots')!;
    let folder = folders[0];
    let activeItem: HTMLElement = folder;
    let pages = document.getElementById(folder.getAttribute('aria-controls')!)!;
    let links = Array.from(pages.querySelectorAll<HTMLAnchorElement>('a'));
    directory.querySelectorAll<HTMLElement>('.pages').forEach(panel => { panel.hidden = panel !== pages; });
    const remembered = new Map<HTMLElement, HTMLAnchorElement>();
    const browser = directory.querySelector<HTMLElement>('.directory-browser')!;
    const pipe = directory.querySelector<SVGPathElement>('.directory-pipes path')!;
    let audio: AudioContext | undefined;
    const beep = () => {
      if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      try {
        audio ??= new AudioContext();
        void audio.resume();
        const oscillator = audio.createOscillator(), gain = audio.createGain(), now = audio.currentTime;
        oscillator.type = 'sine'; oscillator.frequency.value = 1100;
        gain.gain.setValueAtTime(0, now);
        gain.gain.linearRampToValueAtTime(.025, now + .003);
        gain.gain.exponentialRampToValueAtTime(.0001, now + .045);
        oscillator.connect(gain); gain.connect(audio.destination);
        oscillator.start(now); oscillator.stop(now + .05);
      } catch { /* Browsers without audio still allow navigation. */ }
    };
    directory.addEventListener('click', beep);
    let pipeFrame = 0;
    let pipeReveal: Animation | undefined;
    const pipeSvg = browser.querySelector<SVGSVGElement>('.directory-pipes')!;
    const drawPipes = () => {
      const root = folder.getBoundingClientRect();
      const x = roots.offsetLeft + folder.offsetWidth + 5, y = root.height / 2;
      const paths = links.map(link => {
        const row = link.closest('li') as HTMLElement;
        const first = pages.querySelector<HTMLElement>('li')!;
        const endX = pages.offsetLeft + (directory.classList.contains('folder-open') ? 0 : -6) - 5;
        const endY = row.offsetTop - first.offsetTop + (parseFloat(pages.style.getPropertyValue('--selected-y')) || 0) + row.offsetHeight / 2;
        const middle = (x + endX) / 2, sign = Math.sign(endY - y);
        const radius = Math.max(0, Math.min(5, (endX - x) / 4, Math.abs(endY - y) / 2));
        if (Math.abs(endY - y) < 1) return `M${x} ${y}H${endX}`;
        return `M${x} ${y}H${middle-radius}Q${middle} ${y} ${middle} ${y+sign*radius}V${endY-sign*radius}Q${middle} ${endY} ${middle+radius} ${endY}H${endX}`;
      });
      pipe.setAttribute('d', paths.join(' '));
    };
    const followPipes = () => {
      cancelAnimationFrame(pipeFrame);
      pipeReveal?.cancel();
      pipeSvg.style.clipPath = 'inset(-1000px 100% -1000px 0)';
      pipeFrame = requestAnimationFrame(() => {
        if (!directory.isConnected) return;
        drawPipes();
        pipeSvg.style.clipPath = 'inset(-1000px 0% -1000px 0)';
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          pipeReveal = pipeSvg.animate([
            {clipPath: 'inset(-1000px 100% -1000px 0)'},
            {clipPath: 'inset(-1000px 0% -1000px 0)'}
          ], {duration: 180, easing: 'cubic-bezier(.2,.8,.2,1)'});
        }
      });
    };
    const alignSelection = (selected: HTMLElement) => {
      activeItem = selected;
      if (selected.matches('.folder')) {
        const next = selected as HTMLButtonElement;
        if (next !== folder) {
          folder.setAttribute('aria-expanded', 'false');
          pages.hidden = true;
          folder = next;
          pages = document.getElementById(folder.getAttribute('aria-controls')!)!;
          pages.hidden = false;
          pages.inert = true;
          pages.setAttribute('aria-hidden', 'true');
          links = Array.from(pages.querySelectorAll<HTMLAnchorElement>('a'));
          directory.classList.remove('folder-open');
        }
        folders.forEach(item => item.classList.toggle('is-selected', item === folder));
        const row = folder.closest('li') as HTMLElement, first = roots.querySelector<HTMLElement>('li')!;
        roots.style.setProperty('--selected-y', `${-(row.offsetTop-first.offsetTop)}px`);
      } else if (pages.contains(selected)) {
        remembered.set(pages, selected as HTMLAnchorElement);
        links.forEach(link => link.closest('li')!.classList.toggle('is-selected', link === selected));
      }
      const child = remembered.get(pages);
      if (!child) { followPipes(); return; }
      const row = child.closest('li') as HTMLElement;
      const first = pages.querySelector<HTMLElement>('li')!;
      const offset = row.offsetTop - first.offsetTop;
      pages.style.setProperty('--selected-y', `${-offset}px`);
      followPipes();
    };
    directory.addEventListener('focusin', event => alignSelection(event.target as HTMLElement));
    const setOpen = (open: boolean) => {
      folder.setAttribute('aria-expanded', String(open));
      pages.inert = !open;
      pages.setAttribute('aria-hidden', String(!open));
      directory.classList.toggle('folder-open', open);
      followPipes();
      if (!open) folder.focus({preventScroll: true});
    };
    folders.forEach(item => item.addEventListener('click', () => { item.focus({preventScroll:true}); setOpen(folder.getAttribute('aria-expanded') !== 'true'); }));
    document.addEventListener('keydown', (event) => {
      const keyEvent = event as KeyboardEvent;
      if (!directory.isConnected) return;
      if (keyEvent.altKey || keyEvent.ctrlKey || keyEvent.metaKey) return;
      const focused = document.activeElement as HTMLElement;
      if (!directory.contains(focused)) {
        if (focused?.closest('a, button, input, textarea, select')) return;
        if (keyEvent.key === 'Enter') { keyEvent.preventDefault(); activeItem.click(); return; }
      }
      if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(keyEvent.key)) return;
      keyEvent.preventDefault();
      const current = directory.contains(focused) ? focused : activeItem;
      const previousItem = activeItem, wasOpen = folder.getAttribute('aria-expanded');
      const items: HTMLElement[] = pages.contains(current) ? links : folders;
      const index = Math.max(0, items.indexOf(current));
      if (keyEvent.key === 'ArrowDown' || keyEvent.key === 'ArrowUp') {
        items[(index + (keyEvent.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length].focus({preventScroll: true});
      } else if (keyEvent.key === 'ArrowRight') {
        if (current === folder) { setOpen(true); (remembered.get(pages) ?? links[0])?.focus({preventScroll: true}); }
      } else {
        setOpen(false);
      }
      if (activeItem !== previousItem || folder.getAttribute('aria-expanded') !== wasOpen) beep();
    });
    folder.focus({preventScroll: true});
    drawPipes();
    window.addEventListener('resize', () => { if (directory.isConnected) { alignSelection(directory.contains(document.activeElement) ? document.activeElement as HTMLElement : folder); } });
  }
  initializeDirectory();
  document.addEventListener('astro:page-load', initializeDirectory);
</script>

<style>
  :global(body.workspace-page) { padding-top: 0; background: #fff; color: #111; }
  .home { position: absolute; top: 20px; left: 20px; display: block; width: 24px; height: 24px; }
  .home img { display: block; }
  .workspace { min-height: 100svh; display: grid; place-items: center; padding: 64px 20px; font: 14px/1.8 ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { white-space: nowrap; }
  .directory-browser { position: relative; display: flex; align-items: flex-start; gap: 5ch; height: 1.8em; }
  .directory-pipes { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; fill: none; stroke: currentColor; stroke-width: .7; opacity: .16; transition: opacity 140ms ease-out; }
  .folder-open .directory-pipes { opacity: .3; }
  .folder { padding: 0; border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; opacity: .35; transition: opacity 140ms ease-out; }
  .folder.is-selected { opacity: 1; }
  .roots { transform: translateY(var(--selected-y, 0px)); transition: transform 180ms cubic-bezier(.2,.8,.2,1); }
  .pages { transform: translate(-6px, var(--selected-y, 0px)); transition: transform 180ms cubic-bezier(.2,.8,.2,1); }
  .pages li { opacity: .22; transition: opacity 140ms ease-out; }
  .folder-open .pages { transform: translate(0, var(--selected-y, 0px)); }
  .folder-open .pages li { opacity: .35; }
  .folder-open .pages li.is-selected { opacity: 1; }
  .workspace a { color: inherit; text-decoration: none; }
  .workspace a:hover { text-decoration: underline; }
  .workspace a:focus-visible, .folder:focus-visible { outline: none; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 360px) { .workspace { font-size: 12px; } .directory-browser { gap: 4ch; } }
  @media (prefers-reduced-motion: reduce) { .roots, .pages, .pages li, .folder { transition: none; } }
</style>
