---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="workspace — onmk" hideNav hideFooter bodyClass="workspace-page">
  <a class="home" href="/" aria-label="トップに戻る" data-astro-reload>
    <img src="/assets/onmk-icon.jpg" alt="" width="24" height="24" />
  </a>
  <main class="workspace">
    <div class="directory-browser">
    <svg class="directory-pipes" aria-hidden="true"><path /></svg>
    <ul aria-label="ディレクトリ">
      <li><button class="folder" aria-expanded="false" aria-controls="wadalab-pages"><span aria-hidden="true">- </span>wadalab-motion/</button></li>
    </ul>
    <ul class="pages" id="wadalab-pages" aria-label="wadalab-motionのページ" aria-hidden="true" inert>
        <li><span aria-hidden="true">- </span><a href="/workspace/wadalab-motion/" data-astro-reload>index.html</a></li>
        <li><span aria-hidden="true">- </span><a href="/workspace/wadalab-motion/wadamotion-1/" data-astro-reload>Wadamotion-1/</a></li>
        <li><span aria-hidden="true">- </span><a href="/workspace/wadalab-motion/wadamotion-2/" data-astro-reload>Wadamotion-2/</a></li>
        <li><span aria-hidden="true">- </span><a href="/workspace/wadalab-motion/wadamotion-3/" data-astro-reload>Wadamotion-3/</a></li>
    </ul>
    </div>
  </main>
</Layout>

<script>
  function initializeDirectory() {
    const directory = document.querySelector<HTMLElement>('.workspace');
    if (!directory || directory.dataset.keyboardReady) return;
    directory.dataset.keyboardReady = 'true';
    const folder = directory.querySelector<HTMLButtonElement>('.folder')!;
    const pages = directory.querySelector<HTMLElement>('.pages')!;
    const links = Array.from(pages.querySelectorAll<HTMLAnchorElement>('a'));
    const browser = directory.querySelector<HTMLElement>('.directory-browser')!;
    const pipe = directory.querySelector<SVGPathElement>('.directory-pipes path')!;
    let pipeFrame = 0;
    const drawPipes = () => {
      const origin = browser.getBoundingClientRect(), root = folder.getBoundingClientRect();
      const x = root.right - origin.left + 5, y = root.top - origin.top + root.height / 2;
      const paths = links.map(link => {
        const row = link.closest('li')!.getBoundingClientRect();
        const endX = row.left - origin.left - 5, endY = row.top - origin.top + row.height / 2;
        const middle = (x + endX) / 2, sign = Math.sign(endY - y);
        const radius = Math.max(0, Math.min(5, (endX - x) / 4, Math.abs(endY - y) / 2));
        if (Math.abs(endY - y) < 1) return `M${x} ${y}H${endX}`;
        return `M${x} ${y}H${middle-radius}Q${middle} ${y} ${middle} ${y+sign*radius}V${endY-sign*radius}Q${middle} ${endY} ${middle+radius} ${endY}H${endX}`;
      });
      pipe.setAttribute('d', paths.join(' '));
    };
    const followPipes = () => {
      cancelAnimationFrame(pipeFrame);
      const until = performance.now() + 220;
      const frame = (now: number) => { drawPipes(); if (now < until && directory.isConnected) pipeFrame = requestAnimationFrame(frame); };
      pipeFrame = requestAnimationFrame(frame);
    };
    const alignSelection = (selected: HTMLElement) => {
      const row = selected.closest('li') as HTMLElement;
      const first = pages.querySelector<HTMLElement>('li')!;
      const offset = pages.contains(selected) ? row.offsetTop - first.offsetTop : 0;
      pages.style.setProperty('--selected-y', `${-offset}px`);
      followPipes();
    };
    directory.addEventListener('focusin', event => alignSelection(event.target as HTMLElement));
    const setOpen = (open: boolean) => {
      folder.setAttribute('aria-expanded', String(open));
      pages.inert = !open;
      pages.setAttribute('aria-hidden', String(!open));
      directory.classList.toggle('folder-open', open);
      followPipes();
      if (!open) folder.focus({preventScroll: true});
    };
    folder.addEventListener('click', () => setOpen(folder.getAttribute('aria-expanded') !== 'true'));
    directory.addEventListener('keydown', (event) => {
      const keyEvent = event as KeyboardEvent;
      if (keyEvent.altKey || keyEvent.ctrlKey || keyEvent.metaKey) return;
      if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(keyEvent.key)) return;
      keyEvent.preventDefault();
      const current = document.activeElement as HTMLElement;
      const items: HTMLElement[] = pages.contains(current) ? links : [folder];
      const index = Math.max(0, items.indexOf(current));
      if (keyEvent.key === 'ArrowDown' || keyEvent.key === 'ArrowUp') {
        items[(index + (keyEvent.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length].focus({preventScroll: true});
      } else if (keyEvent.key === 'ArrowRight') {
        if (current === folder) { setOpen(true); links[0]?.focus({preventScroll: true}); }
      } else {
        setOpen(false);
      }
    });
    folder.focus({preventScroll: true});
    drawPipes();
    window.addEventListener('resize', () => { if (directory.isConnected) { alignSelection(directory.contains(document.activeElement) ? document.activeElement as HTMLElement : folder); } });
  }
  initializeDirectory();
  document.addEventListener('astro:page-load', initializeDirectory);
</script>

<style>
  :global(body.workspace-page) { padding-top: 0; background: #fff; color: #111; }
  .home { position: absolute; top: 20px; left: 20px; display: block; width: 24px; height: 24px; }
  .home img { display: block; }
  .workspace { min-height: 100svh; display: grid; place-items: center; padding: 64px 20px; font: 14px/1.8 ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { white-space: nowrap; }
  .directory-browser { position: relative; display: flex; align-items: flex-start; gap: 5ch; height: 1.8em; }
  .directory-pipes { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; fill: none; stroke: currentColor; stroke-width: .7; opacity: .16; transition: opacity 140ms ease-out; }
  .folder-open .directory-pipes { opacity: .3; }
  .folder { padding: 0; border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; opacity: .35; transition: opacity 140ms ease-out; }
  .folder:focus { opacity: 1; }
  .pages { transform: translate(-6px, var(--selected-y, 0px)); transition: transform 180ms cubic-bezier(.2,.8,.2,1); }
  .pages li { opacity: .22; transition: opacity 140ms ease-out; }
  .folder-open .pages { transform: translate(0, var(--selected-y, 0px)); }
  .folder-open .pages li { opacity: .35; }
  .folder-open .pages li:focus-within { opacity: 1; }
  .workspace a { color: inherit; text-decoration: none; }
  .workspace a:hover { text-decoration: underline; }
  .workspace a:focus-visible, .folder:focus-visible { outline: none; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 360px) { .workspace { font-size: 12px; } .directory-browser { gap: 4ch; } }
  @media (prefers-reduced-motion: reduce) { .pages, .pages li, .folder { transition: none; } }
</style>
