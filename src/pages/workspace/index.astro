---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="workspace — onmk" hideNav hideFooter>
  <a class="home" href="/" aria-label="トップに戻る" data-astro-reload>
    <img src="/assets/onmk-icon.jpg" alt="" width="24" height="24" />
  </a>
  <main class="workspace">
    <ul aria-label="ディレクトリ">
      <li><span aria-hidden="true">- </span><a href="/workspace/wadalab-motion/" data-astro-reload>wadalab-motion/</a></li>
    </ul>
  </main>
</Layout>

<style>
  :global(body) { padding-top: 0; background: #fff; color: #111; }
  .home { position: absolute; top: 20px; left: 20px; display: block; width: 24px; height: 24px; }
  .home img { display: block; }
  .workspace { min-height: 100svh; display: grid; place-items: center; padding: 64px 20px; font: 14px/1.8 ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { white-space: pre; }
  .workspace a { color: inherit; text-decoration: none; }
  .workspace a:hover { text-decoration: underline; }
</style>
