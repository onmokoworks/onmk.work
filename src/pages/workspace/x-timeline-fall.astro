---
const rows=[{lines:2,media:true},{lines:3,quote:true},{lines:1},{lines:3},{lines:2},{lines:1}];
---
<!doctype html><html lang="ja" data-color-scheme="light"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>X-timeline-fall — workspace</title><link rel="icon" href="data:,"/><link rel="stylesheet" href="/workspace/x-timeline-fall/content.css"/></head><body>
<div class="shell"><header><nav aria-label="ダミーのナビゲーション"><a class="logo block" href="/workspace/" aria-label="workspaceに戻る"></a>{Array.from({length:8},(_,i)=><a class="nav-row" href="#timeline" aria-label={`ダミー項目${i+1}`}><span class="icon block"></span><span class="nav-label block" style={`width:${[76,112,56,112,64,112,112,96][i]}px`}></span></a>)}<div class="post-button block"></div><div class="account" data-testid="SideNav_AccountSwitcher_Button"><div class="avatar block"></div><div class="account-lines"><span class="line block"></span><span class="line short block"></span></div><div class="dots block"></div></div></nav></header>
<main id="timeline" aria-label="ダミーのタイムライン"><div class="tabs"><div><span class="tab-label block"></span><span class="underline"></span></div><div><span class="tab-label block"></span></div><span class="dots block"></span></div><div class="compose"><div class="avatar block"></div><div class="compose-content"><span class="input-line block"></span><div class="tools"><div>{Array.from({length:5},()=> <span class="small-icon block"></span>)}</div><span class="submit block"></span></div></div></div><div class="new-posts"><span class="block"></span></div>
{rows.map((row,index)=><article data-testid="tweet" aria-label={`ダミー投稿${index+1}`}><div class="avatar block"></div><div class="post"><div class="name"><span class="user-name block"></span><span class="handle block"></span><span class="dots block"></span></div><div class="text-lines">{Array.from({length:row.lines},(_,i)=><span class="line block" style={`width:${i===row.lines-1?[68,82,53,76,61,44][index]:96}%`}></span>)}</div>{row.media&&<div class="media block"></div>}{row.quote&&<div class="quote"><span class="quote-name block"></span><span class="line block"></span><span class="line short block"></span></div>}<div class="actions">{Array.from({length:4},()=> <div><span class="small-icon block"></span><span class="count block"></span></div>)}<div><span class="small-icon block"></span><span class="small-icon block"></span></div></div></div></article>)}
</main><aside><div class="search block"></div><section><span class="section-title block"></span><span class="line block"></span><span class="line short block"></span><span class="aside-button block"></span></section><section><span class="section-title block"></span>{Array.from({length:4},()=> <div class="trend" data-testid="trend"><span class="line short block"></span><span class="trend-title block"></span><span class="line short block"></span><span class="dots block"></span></div>)}<span class="more-line block"></span></section><section><span class="section-title block"></span>{Array.from({length:2},()=> <div class="follow" data-testid="UserCell"><span class="avatar block"></span><div><span class="line block"></span><span class="line short block"></span></div><span class="follow-button block"></span></div>)}</section><div class="footer-lines"><span class="line block"></span><span class="line short block"></span></div></aside></div>
<a class="back" href="/workspace/" aria-label="workspaceに戻る">←</a>
<script is:inline src="/workspace/x-timeline-fall/matter.min.js"></script><script is:inline src="/workspace/x-timeline-fall/content.js"></script>
</body></html>
<style is:global>
*{box-sizing:border-box}html,body{margin:0;background:#fff;color:#0f1419;font:15px/1.35 Arial,sans-serif}a{color:inherit;text-decoration:none}.block{display:block;background:#e5e8eb;border-radius:4px;flex:none}.shell{max-width:1265px;margin:auto;display:grid;grid-template-columns:275px 600px 350px}header{padding:0 12px}nav{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;align-items:flex-start;gap:3px;padding:16px 12px}.logo{width:30px;height:30px;margin-bottom:10px;border-radius:6px}.nav-row{height:53px;display:flex;align-items:center;gap:20px}.icon{width:27px;height:27px;border-radius:7px}.nav-label{height:18px;border-radius:5px}.post-button{height:52px;width:90%;border-radius:30px;margin:12px 0;background:#cdd2d7}.account{display:flex;align-items:center;gap:12px;width:100%;margin-top:auto;padding-bottom:20px}.avatar{width:40px;height:40px;border-radius:50%;background:#d9dee3}.account-lines{flex:1}.account .line{width:80px}.line{height:12px;margin:8px 0;width:96%;border-radius:3px}.line.short{width:62%}.dots{width:18px;height:5px;border-radius:3px;flex:none}.account .dots{margin-right:12px}main{border-left:1px solid #eff3f4;border-right:1px solid #eff3f4;min-height:100vh}.tabs{height:53px;display:flex;align-items:center;border-bottom:1px solid #eff3f4;background:#fff;position:sticky;top:0;z-index:2}.tabs>div{flex:1;height:100%;display:grid;place-items:center;position:relative}.tab-label{width:70px;height:14px}.underline{position:absolute;width:56px;height:4px;background:#1da1f2;bottom:0;left:50%;transform:translateX(-50%);border-radius:3px}.tabs>.dots{margin:0 16px}.compose{display:flex;gap:12px;padding:16px 16px 8px}.compose-content{flex:1}.input-line{height:18px;width:160px;margin:12px 0 30px}.tools{border-top:1px solid #eff3f4;padding-top:12px;display:flex;align-items:center;justify-content:space-between}.tools>div{display:flex;gap:16px}.small-icon{width:17px;height:17px;border-radius:5px}.submit{width:100px;height:36px;border-radius:24px;background:#d3d8dd}.new-posts{height:49px;display:grid;place-items:center;border-block:1px solid #eff3f4}.new-posts>span{height:12px;width:135px}article{display:flex;gap:12px;padding:14px 16px;border-bottom:1px solid #eff3f4;background:#fff}.post{flex:1;min-width:0}.name{display:flex;align-items:center;gap:8px;height:20px}.user-name{width:68px;height:13px;background:#cbd2d9}.handle{width:128px;height:11px}.name>.dots{margin-left:auto}.text-lines{padding:4px 0 8px}.text-lines .line{margin:7px 0}.actions{display:flex;justify-content:space-between;margin-top:12px;gap:8px}.actions>div{display:flex;align-items:center;gap:7px}.count{width:22px;height:8px}.media{height:260px;border:1px solid #dfe3e7;border-radius:16px;background:#e3e7eb}.quote{border:1px solid #e2e6ea;border-radius:16px;padding:14px}.quote-name{height:12px;width:110px;background:#d4dae0;margin-bottom:14px}.quote .line{margin:8px 0}aside{padding:5px 0 20px 30px}.search{border-radius:24px;background:#eff1f3;height:44px;margin-bottom:16px}aside section{border:1px solid #eff3f4;border-radius:16px;margin-bottom:16px;padding:16px}.section-title{height:19px;width:80%;margin-bottom:18px;background:#cdd4db}.aside-button{width:120px;height:34px;border-radius:24px;margin-top:14px;background:#d4dae0}.trend{position:relative;padding:7px 0 14px}.trend .line{height:9px;width:55%}.trend-title{height:13px;width:65%;background:#d0d7de;margin:8px 0}.trend>.dots{position:absolute;right:0;top:12px}.more-line{width:76px;height:12px;margin:14px 0 2px}.follow{display:flex;align-items:center;gap:10px;padding:8px 0}.follow>div{flex:1}.follow .line{width:75px;height:10px}.follow .short{width:58px;height:8px}.follow-button{width:70px;height:30px;border-radius:20px;background:#d1d8de}.footer-lines{padding:0 16px}.footer-lines .line{height:8px}.back{position:fixed;bottom:20px;left:20px;color:#9aa3aa;font:16px monospace;z-index:3}#xtp-controls{background:#fff;padding:8px;border:1px solid #d7dce1;box-shadow:0 2px 12px #0001;border-radius:30px}@media(max-width:1250px){.shell{max-width:1080px;grid-template-columns:90px minmax(0,600px) 350px}.nav-label,.post-button,.account-lines,.account>.dots{display:none}nav{align-items:center;padding-inline:0}.account{justify-content:center}.nav-row{padding:13px}.logo{margin-bottom:10px}}@media(max-width:1050px){.shell{max-width:690px;grid-template-columns:90px minmax(0,600px)}aside{display:none}}@media(max-width:650px){.shell{display:block}header{display:none}main{border:0}.compose{display:none}.media{height:220px}.handle{width:100px}.user-name{width:58px}.actions{gap:4px}.count{width:16px}.actions>div{gap:4px}#xtp-controls{right:10px;bottom:10px}}
</style>

<style is:global>.post-button,.submit{background:#1da1f2}</style>
