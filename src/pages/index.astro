---
import Layout from "../layouts/Layout.astro";
import { getTimeline, type TimelineKind } from "../library/timeline";

const timeline = await getTimeline();

// Twemoji codepoints per kind (SVGs vendored in /public/emoji/).
const emojiCode: Partial<Record<TimelineKind, string>> = {
  work: "1f3ac", // 🎬
  blog: "1f4dd", // 📝
};

const fmtDate = (iso: string) => {
  const d = new Date(iso);
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");
  return `${mm}.${dd}`;
};
---

<Layout title="onmk">
  <div class="container">
    <section class="intro">
      <p class="intro-name">おーん / onmk</p>
      <a href="/about" class="intro-more">about →</a>
    </section>

    <section class="timeline">
      <span class="section-title">直近の活動</span>

      {timeline.length === 0 && (
        <p class="tl-empty">まだ表示できる活動がありません。</p>
      )}

      {timeline.map((group) => (
        <div class="tl-group">
          <div class="tl-year">{group.year}</div>
          <ol class="tl-list">
            {group.entries.map((entry) => (
              <li class="tl-item" data-kind={entry.kind}>
                <a
                  class="tl-link"
                  href={entry.href}
                  target={entry.external ? "_blank" : undefined}
                  rel={entry.external ? "noopener" : undefined}
                >
                  <span class="tl-icon" aria-hidden="true">
                    <img class="tl-emoji" src={`/emoji/${entry.emojiCode ?? emojiCode[entry.kind]}.svg`} alt="" loading="lazy" />
                  </span>
                  <span class="tl-content">
                    <span class="tl-meta">
                      <span class="tl-date">{fmtDate(entry.date)}</span>
                      <span class="tl-badge">{entry.badge}</span>
                      {entry.meta && <span class="tl-tag">{entry.meta}</span>}
                    </span>
                    <span class="tl-title">
                      {entry.title}
                      {entry.external && <span class="tl-arrow" aria-hidden="true">↗</span>}
                    </span>
                    {entry.summary && <span class="tl-summary">{entry.summary}</span>}
                    {entry.thumbnail && (
                      <span class="tl-thumb">
                        <img src={entry.thumbnail} alt="" loading="lazy" />
                      </span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>
  </div>
</Layout>

<style>
  /* Self-intro */
  .intro {
    margin-bottom: 56px;
  }
  .intro-name {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-bottom: 14px;
  }
  .intro-more {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--text-sub);
    text-decoration: none;
    transition: color 0.2s;
  }
  .intro-more:hover { color: var(--text-main); }

  .section-title {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 40px;
    display: block;
    color: var(--text-sub);
  }

  .tl-empty {
    font-size: 0.85rem;
    color: var(--text-sub);
  }

  /* Year group */
  .tl-group { margin-bottom: 48px; }
  .tl-group:last-child { margin-bottom: 0; }
  .tl-year {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: 0.04em;
    padding-bottom: 14px;
    margin-bottom: 8px;
    border-bottom: 0.1px solid var(--border-color);
  }

  .tl-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .tl-item { position: relative; }
  /* Connector line running down the icon column between entries */
  .tl-item:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 14px;
    top: 31px;
    bottom: -31px;
    border-left: 0.1px solid var(--border-color);
    z-index: 0;
    pointer-events: none;
  }

  .tl-link {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 14px;
    padding: 16px 8px;
    margin: 0 -8px;
    text-decoration: none;
    color: var(--text-main);
    border-radius: 18px;
    corner-shape: squircle;
    transition: background-color 0.18s ease;
  }
  .tl-link:hover { background-color: rgba(0, 0, 0, 0.03); }
  html[data-theme="dark"] .tl-link:hover,
  html[data-theme="flashlight"] .tl-link:hover { background-color: rgba(255, 255, 255, 0.04); }

  .tl-icon {
    position: relative;
    z-index: 1;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 0.1px solid var(--border-color);
    background: var(--bg-color);
    color: var(--text-sub);
    margin-top: 1px;
  }
  .tl-icon svg { width: 14px; height: 14px; }
  .tl-icon .tl-emoji {
    width: 16px;
    height: 16px;
    display: block;
    filter: grayscale(1);
  }
  .tl-item[data-kind="blog"] .tl-icon,
  .tl-item[data-kind="work"] .tl-icon { color: var(--text-main); }

  .tl-content {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .tl-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-sub);
  }
  .tl-date { font-variant-numeric: tabular-nums; }
  .tl-badge { color: var(--text-sub); }
  .tl-tag {
    color: var(--text-sub);
    opacity: 0.7;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .tl-tag::before { content: "· "; }

  .tl-title {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.01em;
    word-break: break-word;
  }
  .tl-link:hover .tl-title {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border-color);
  }
  .tl-arrow {
    font-size: 0.7rem;
    color: var(--text-sub);
    margin-left: 4px;
    display: inline-block;
  }

  .tl-thumb {
    display: block;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 16 / 10;
    margin-top: 12px;
    overflow: hidden;
    border-radius: 18px;
    corner-shape: squircle;
    background: var(--border-color);
    border: 0.1px solid var(--border-color);
  }
  .tl-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .tl-link:hover .tl-thumb img { transform: scale(1.04); }

  .tl-summary {
    font-size: 0.75rem;
    line-height: 1.65;
    color: var(--text-sub);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .tl-link { grid-template-columns: 24px 1fr; gap: 12px; }
    .tl-icon { width: 24px; height: 24px; }
    .tl-icon svg { width: 12px; height: 12px; }
    .tl-icon .tl-emoji { width: 14px; height: 14px; }
    .tl-item:not(:last-child)::before { left: 12px; top: 29px; bottom: -29px; }
  }

</style>
