---
import Layout from "../../layouts/Layout.astro";
import { getBlogPosts, type BlogPost } from "../../library/microcms";

let posts: BlogPost[] = [];
try {
  const res = await getBlogPosts({ orders: "-publishedAt", limit: 100 });
  posts = res.contents;
} catch {
  // microCMS の blog エンドポイント未作成 / 認証なしのときは空表示
  posts = [];
}

function stripHtml(html?: string) {
  return (html ?? "").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
}

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title="writings | onmk">
  <div class="container">
    <span class="section-title">Writings</span>

    {posts.length === 0 ? (
      <p class="blog-empty">まだ記事がありません。</p>
    ) : (
      <ol class="blog-list">
        {posts.map((post) => (
          <li class="blog-item">
            <a href={`/writings/${post.slug ?? post.id}`} class="blog-link">
              <span class="blog-date">{fmtDate(post.publishedAt)}</span>
              <span class="blog-title">{post.title}</span>
              {(post.excerpt || post.body) && (
                <span class="blog-excerpt">{post.excerpt ?? stripHtml(post.body)}</span>
              )}
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</Layout>

<style>
  .container { padding-top: 40px; }

  .section-title {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 40px;
    display: block;
    color: var(--text-sub);
  }

  .blog-empty {
    font-size: 0.85rem;
    color: var(--text-sub);
  }

  .blog-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .blog-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 8px;
    margin: 0 -8px;
    text-decoration: none;
    color: var(--text-main);
    border-bottom: 0.1px solid var(--border-color);
    border-radius: 8px;
    transition: background-color 0.18s ease;
  }
  .blog-item:last-child .blog-link { border-bottom: none; }
  html[data-theme="dark"] .blog-link:hover,
  html[data-theme="flashlight"] .blog-link:hover { background-color: rgba(255, 255, 255, 0.04); }
  .blog-link:hover { background-color: rgba(0, 0, 0, 0.03); }

  .blog-date {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-sub);
    font-variant-numeric: tabular-nums;
  }
  .blog-title {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }
  .blog-link:hover .blog-title {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border-color);
  }
  .blog-excerpt {
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-sub);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
