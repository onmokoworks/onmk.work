---
import Layout from "../../layouts/Layout.astro";
import { getBlogPosts, getBlogPostBySlug } from "../../library/microcms";

export async function getStaticPaths() {
  try {
    const response = await getBlogPosts({ fields: ["id", "slug"], limit: 100 });
    return response.contents.map((post) => ({
      params: { slug: post.slug ?? post.id },
    }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug as string);

// 一覧ページ(writings/index.astro)と同じ 2026.01.31 形式
const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Tokyo",
  }).format(new Date(iso)).replaceAll("/", ".");
---

<Layout
  title={`${post.title} | onmk`}
  description={post.excerpt || post.body}
  image={post.eyecatch?.url}
  ogType="article"
>
  <div class="container">
    <a href="/writings" class="back">← writings</a>

    <article class="blog-detail">
      {post.eyecatch && (
        <div class="blog-eyecatch">
          <img src={`${post.eyecatch.url}?w=1200`} alt="" />
        </div>
      )}

      <header class="blog-head">
        <span class="blog-date">{fmtDate(post.publishedAt)}</span>
        <h1 class="blog-title">{post.title}</h1>
        {post.tag && post.tag.length > 0 && (
          <div class="blog-tags">
            {post.tag.map((t) => <span class="blog-tag">{t.title}</span>)}
          </div>
        )}
      </header>

      {post.body && <div class="blog-body" set:html={post.body}></div>}
    </article>
  </div>
</Layout>

<style>
  .container { max-width: 680px; padding-top: 40px; }

  .back {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--text-sub);
    text-decoration: none;
    letter-spacing: 0.05em;
    margin-bottom: 40px;
    transition: color 0.2s;
  }
  .back:hover { color: var(--text-main); }

  .blog-head { margin-bottom: 28px; }
  .blog-date {
    display: block;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-sub);
    margin-bottom: 8px;
  }
  .blog-title {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .blog-tag {
    font-size: 0.6rem;
    color: var(--text-sub);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-eyecatch {
    margin-bottom: 28px;
  }
  .blog-eyecatch img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }

  .blog-body {
    font-size: 0.9rem;
    line-height: 1.9;
    color: var(--text-main);
    overflow-wrap: anywhere;
    --link: #1660d8;
    --code-bg: color-mix(in srgb, var(--text-main) 8%, transparent);
  }
  :global(html[data-theme="dark"]) .blog-body,
  :global(html[data-theme="flashlight"]) .blog-body {
    --link: #7db0ff;
  }
  .blog-body :global(p) { margin-bottom: 18px; }
  /* エディタの空行(空の段落)で余白が不揃いにならないようにする */
  .blog-body :global(p:empty) { display: none; }
  .blog-body :global(h2) {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 40px 0 14px;
    letter-spacing: 0.01em;
  }
  .blog-body :global(h3) {
    font-size: 0.95rem;
    font-weight: 500;
    margin: 32px 0 12px;
  }
  .blog-body :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .blog-body :global(a:hover) { text-decoration-thickness: 2px; }
  .blog-body :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 24px 0;
  }
  .blog-body :global(ul),
  .blog-body :global(ol) {
    margin: 0 0 18px;
    padding-left: 1.9em;
  }
  .blog-body :global(ul) { list-style: disc; }
  .blog-body :global(ol) { list-style: decimal; }
  .blog-body :global(li) {
    margin-bottom: 8px;
    padding-left: 0.3em;
  }
  .blog-body :global(li::marker) {
    color: var(--text-sub);
    font-variant-numeric: tabular-nums;
  }
  .blog-body :global(li > ul),
  .blog-body :global(li > ol) { margin: 8px 0 0; }
  .blog-body :global(li > p) { margin-bottom: 0; }
  .blog-body :global(blockquote) {
    margin: 0 0 18px;
    padding-left: 16px;
    border-left: 2px solid var(--border-color);
    color: var(--text-sub);
  }
  .blog-body :global(pre) {
    background: #f6f6f6;
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.8rem;
    margin-bottom: 18px;
  }
  :global(html[data-theme="dark"]) .blog-body :global(pre),
  :global(html[data-theme="flashlight"]) .blog-body :global(pre) {
    background: #161616;
  }
  .blog-body :global(code) {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.84em;
    background: var(--code-bg);
    padding: 0.18em 0.45em;
    border-radius: 4px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .blog-body :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .blog-body :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: none;
    display: block;
    margin: 24px 0;
  }
</style>
