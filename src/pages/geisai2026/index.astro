---
import QRCode from 'qrcode';
import Layout from '../../layouts/Layout.astro';

// 21:9 の展示画面用。左 5/21 に説明、右 16/21 で試打と説明（Wadamotion-4 の動き）を切り替える。
const tryUrl = 'https://onmk.work/workspace/wadalab-motion/';
const qr = await QRCode.toString(tryUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#111111', light: '#0000' } });
---

<Layout title="wadalab-motion — 芸祭" hideNav hideFooter noindex bodyClass="geisai-page">
  <div class="frame" data-mode="attract">
    <aside class="panel">
      <h1>wadalab-motion</h1>
      <p class="hint hint-attract">キーを押すと入力できます</p>
      <p class="hint hint-typing">しばらく打たないと最初の画面に戻ります</p>
      <!-- キー配置は展示用の HHKB と PC の設定に合わせて確認する。 -->
      <dl class="keys">
        <dt><kbd>control</kbd>+<kbd>space</kbd></dt><dd>かな／英数</dd>
        <dt><kbd>space</kbd></dt><dd>変換</dd>
        <dt><kbd>return</kbd></dt><dd>確定・改行</dd>
        <dt><kbd>BS</kbd></dt><dd>1文字消す</dd>
      </dl>
      <figure class="qr">
        <div class="qr-code" set:html={qr} />
        <figcaption>onmk.work/workspace/wadalab-motion</figcaption>
      </figure>
      <dl class="credit">
        <dt>骨格データ</dt><dd>CLWFK（東京大学和田研究室・電子書体オープンラボラトリー）</dd>
        <dt>英数字</dt><dd>和田研細丸ゴシック2004絵文字（希土類元素レアアース）</dd>
      </dl>
    </aside>
    <main class="stage">
      <iframe class="typing" src="/workspace/wadalab-motion/index.html" title="文字を入力"></iframe>
    </main>
  </div>
</Layout>

<style is:global>
  @font-face { font-family: Wadalab; src: url('/workspace/wadalab-motion/font/wlmaru2004emoji.ttf') format('truetype'); font-display: swap; }
  .geisai-page { margin: 0; height: 100vh; overflow: hidden; background: #fff; color: #111; cursor: none; }
  .geisai-page .frame {
    position: absolute; inset: 0; margin: auto;
    width: min(100vw, calc(100vh * 21 / 9)); height: min(100vh, calc(100vw * 9 / 21));
    display: grid; grid-template-columns: 5fr 16fr; container-type: size;
  }
  .geisai-page .panel {
    display: flex; flex-direction: column; gap: 3.2cqh; min-width: 0;
    padding: 6cqh 4.4cqh 5cqh; border-right: 1px solid #ddd;
    font: 2.1cqh/1.75 Wadalab, sans-serif; letter-spacing: .03em;
  }
  .geisai-page h1 { margin: 0; font-size: 3.6cqh; line-height: 1.45; font-weight: normal; }
  .geisai-page .hint { margin: 0; padding-left: 1.2cqh; border-left: 2px solid #111; }
  .geisai-page .keys { margin: 1cqh 0 0; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 2.2cqh 2.4cqh; font-size: 2.3cqh; }
  .geisai-page .keys dt { display: flex; align-items: center; gap: .8cqh; margin: 0; color: #777; }
  .geisai-page .keys dd { margin: 0; }
  .geisai-page kbd { display: inline-block; min-width: 5.2cqh; padding: .5cqh 1.1cqh; border: 1px solid #111; border-bottom-width: 3px; border-radius: .6cqh; color: #111; font: 1.8cqh/1.4 Wadalab, sans-serif; text-align: center; }
  .geisai-page .frame[data-mode="attract"] .hint-typing,
  .geisai-page .frame[data-mode="typing"] .hint-attract { display: none; }
  .geisai-page .qr { margin: auto 0 0; display: flex; align-items: flex-end; gap: 2.4cqh; }
  .geisai-page .qr-code { flex: none; width: 15cqh; }
  .geisai-page .qr-code svg { display: block; width: 100%; height: auto; }
  .geisai-page figcaption { color: #777; font-size: 1.35cqh; overflow-wrap: anywhere; }
  .geisai-page .credit { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: .3cqh 1.4cqh; color: #777; font-size: 1.25cqh; line-height: 1.6; }
  .geisai-page .credit dt, .geisai-page .credit dd { margin: 0; }
  .geisai-page .credit dd { overflow-wrap: anywhere; }
  .geisai-page .stage { position: relative; overflow: hidden; }
  .geisai-page .stage iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .geisai-page .attract { pointer-events: none; opacity: 0; transition: opacity .8s; }
  .geisai-page .attract.is-visible { opacity: 1; }
  .geisai-page .idle-bar { position: absolute; z-index: 1; left: 0; bottom: 0; width: 100%; height: .5cqh; background: #111; transform: scaleX(0); transform-origin: left; opacity: 0; transition: opacity .4s; pointer-events: none; }
  .geisai-page .idle-bar.is-visible { opacity: 1; }
</style>

<script is:inline>
  (() => {
    const params = new URLSearchParams(location.search);
    // 最後の入力からこの秒数で説明の画面に戻す。?idle=10 で調整できる。
    // 線は graceSeconds 後に出て、残りの時間で右端まで伸びる。
    const idleSeconds = Number(params.get('idle')) || 30, graceSeconds = Math.min(3, idleSeconds / 3);
    const frame = document.querySelector('.geisai-page .frame');
    if (!frame) return;
    const stage = frame.querySelector('.stage'), typing = frame.querySelector('.typing');
    const bar = document.createElement('div');
    bar.className = 'idle-bar';
    stage.append(bar);
    let mode = 'attract', lastInput = 0, attract = null, input = null, attractTimer = 0;

    const setMode = next => { mode = next; frame.dataset.mode = next; };
    const focusInput = () => {
      if (!input || input.ownerDocument.querySelector('dialog[open]')) return;
      typing.contentWindow.focus();
      input.focus({ preventScroll: true });
    };

    function showAttract() {
      if (attract) return;
      attract = document.createElement('iframe');
      attract.className = 'attract';
      attract.title = 'wadalab-motion の説明';
      attract.tabIndex = -1;
      attract.src = '/geisai2026/attract/';
      attract.addEventListener('load', () => {
        const style = attract.contentDocument.createElement('style');
        style.textContent = 'a{display:none!important}canvas{cursor:none!important}';
        attract.contentDocument.head.append(style);
        requestAnimationFrame(() => attract?.classList.add('is-visible'));
        focusInput();
      }, { once: true });
      stage.append(attract);
    }

    function hideAttract() {
      clearTimeout(attractTimer);
      if (!attract) return;
      const leaving = attract;
      attract = null;
      leaving.classList.remove('is-visible');
      setTimeout(() => leaving.remove(), 800);
    }

    function enterAttract() {
      setMode('attract');
      // 打たれた文字を消すアニメーションを見せてから切り替える。
      if (input.value) {
        input.value = '';
        input.dispatchEvent(new InputEvent('input', { inputType: 'deleteContentBackward' }));
        attractTimer = setTimeout(showAttract, 1800);
      } else showAttract();
    }

    function activity() {
      lastInput = performance.now();
      if (mode === 'attract') { setMode('typing'); hideAttract(); }
    }

    typing.addEventListener('load', () => {
      const doc = typing.contentDocument;
      const style = doc.createElement('style');
      style.textContent = '#paste,#info{display:none!important}body{cursor:none}';
      doc.head.append(style);
      input = doc.getElementById('input');
      for (const type of ['keydown', 'compositionstart', 'input']) input.addEventListener(type, event => { if (event.isTrusted) activity(); });
      focusInput();
      showAttract();
    });

    // 展示中にフォーカスが外れても、次のキー入力を取りこぼさないようにする。
    document.addEventListener('pointerdown', () => setTimeout(focusInput));
    addEventListener('focus', focusInput);
    setInterval(() => {
      if (input && typing.contentDocument.activeElement !== input) focusInput();
    }, 1000);

    function tick(now) {
      const idle = (now - lastInput) / 1000;
      const progress = mode === 'typing' ? Math.max(0, (idle - graceSeconds) / (idleSeconds - graceSeconds)) : 0;
      bar.classList.toggle('is-visible', progress > 0);
      if (progress > 0) bar.style.transform = `scaleX(${Math.min(1, progress)})`;
      // 右端まで来たら、打たれた文字がほどけて説明の画面に変わる。
      if (progress >= 1) enterAttract();
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();
</script>
