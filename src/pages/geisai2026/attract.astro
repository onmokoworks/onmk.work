---
// /geisai2026/ の待機画面。Wadamotion-4 の動きで、夢十夜の代わりに説明文を流す。
const story = {
  title: 'wadalab-motion',
  phrases: [
    'これは和田研フォントの骨格データを使用したフォントモーションプロジェクトの試作です。',
    '自由にキーボードを操作して試打することができます。',
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>wadalab-motion</title>
    <link rel="icon" href="data:," />
    <style>html,body{margin:0;width:100%;height:100%;background:#fff;overflow:hidden;color:#111}canvas{display:block;width:100%;height:100%;cursor:none}</style>
  </head>
  <body>
    <canvas role="img" aria-label={story.phrases.join('')}></canvas>
    <script is:inline define:vars={{ story }}>
      // motion-4.js は night-one.json を読むので、その応答だけ差し替える。
      const load = window.fetch.bind(window);
      window.fetch = (input, init) => String(input).endsWith('/night-one.json')
        ? Promise.resolve(new Response(JSON.stringify(story), { headers: { 'Content-Type': 'application/json' } }))
        : load(input, init);
    </script>
    <script is:inline type="module" src="/workspace/wadalab-motion/motion-4.js"></script>
  </body>
</html>
